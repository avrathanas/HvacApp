<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Προσθήκη Συνεργάτη"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etStaffName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Όνομα Συνεργάτη"
        android:inputType="textPersonName"/>

    <EditText
        android:id="@+id/etStaffOres"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ώρες"
        android:inputType="numberDecimal"/>

    <EditText
        android:id="@+id/etStaffYperories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Κόστος Υπερωριών"
        android:inputType="numberDecimal"/>

    <EditText
        android:id="@+id/etStaffSavvato"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Σάββατα"
        android:inputType="number"/>

    <EditText
        android:id="@+id/etStaffSynolo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Συνολικό Ποσό"
        android:inputType="numberDecimal"/>

    <Button
        android:id="@+id/btnSaveStaff"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ΑΠΟΘΗΚΕΥΣΗ"
        android:layout_marginTop="16dp"/>

</LinearLayout>