<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <TextView android:id="@+id/tvTitlePeratosi" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="ΠΕΡΑΤΩΣΗ ΕΡΓΩΝ" android:textSize="22sp" android:textStyle="bold" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" />

    <EditText android:id="@+id/etSearchPeratosi" android:layout_width="0dp" android:layout_height="wrap_content"
        android:hint="Αναζήτηση..." android:layout_marginTop="8dp" app:layout_constraintTop_toBottomOf="@id/tvTitlePeratosi"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvPeratosi" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_marginTop="8dp" app:layout_constraintTop_toBottomOf="@id/etSearchPeratosi"
        app:layout_constraintBottom_toBottomOf="parent" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton android:id="@+id/fabAddPeratosi"
        android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="16dp"
        android:src="@android:drawable/ic_input_add" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>