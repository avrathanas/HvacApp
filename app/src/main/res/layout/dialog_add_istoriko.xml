<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Νέα Περάτωση Έργου"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"/>


        <EditText android:id="@+id/etPerName" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Όνομα Πελάτη" android:inputType="textPersonName"/>
        <EditText android:id="@+id/etPerErgasia" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Εργασία" android:inputType="text"/>
        <EditText android:id="@+id/etPerSynergeio" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Συνεργείο " android:inputType="text"/>
        <EditText android:id="@+id/etPerKostos" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Κόστος " android:inputType="numberDecimal"/>
        <EditText android:id="@+id/etPerDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Ημερομηνία" android:inputType="date"/>


        <CheckBox
            android:id="@+id/cbPliromi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Πληρώθηκε"
            android:layout_marginTop="5dp"/>

        <CheckBox
            android:id="@+id/cbOloklirosi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ολοκληρώθηκε"/>

        <EditText
            android:id="@+id/etPerSxolia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Σχόλια / Παρατηρήσεις"
            android:minLines="2"/>

        <Button
            android:id="@+id/btnSavePer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ΑΠΟΘΗΚΕΥΣΗ ΠΕΡΑΤΩΣΗΣ"
            android:layout_marginTop="15dp"/>
    </LinearLayout>
</ScrollView>