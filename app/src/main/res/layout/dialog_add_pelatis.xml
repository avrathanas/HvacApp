<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Νέος Πελάτης"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="15dp"/>

    <EditText android:id="@+id/etName" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Όνομα "/>
    <EditText android:id="@+id/etAddress" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Διεύθυνση"/>
    <EditText android:id="@+id/etPhone" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Τηλέφωνο" android:inputType="phone"/>
    <EditText android:id="@+id/etAfm" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="ΑΦΜ" android:inputType="number"/>
    <EditText android:id="@+id/etDoy" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="ΔΟΥ"/>

    <Button
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="ΑΠΟΘΗΚΕΥΣΗ" />
</LinearLayout>